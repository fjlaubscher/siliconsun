# Writes siliconsun_version.h from SILICONSUN_VERSION.
#
# The product version is independent of the OpenTS project version, which remains the save and
# network stamp. The header changes only when the version or the official-build option changes.
#
# Expects SILICONSUN_VERSION, SILICONSUN_OFFICIAL_BUILD, and SILICONSUN_VERSION_HEADER.

if(NOT DEFINED SILICONSUN_VERSION OR SILICONSUN_VERSION STREQUAL "")
    message(FATAL_ERROR "SILICONSUN_VERSION is required.")
endif()

if(NOT SILICONSUN_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR
        "SILICONSUN_VERSION is \"${SILICONSUN_VERSION}\"; it must be major.minor.patch.")
endif()

set(SILICONSUN_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(SILICONSUN_VERSION_MINOR "${CMAKE_MATCH_2}")
set(SILICONSUN_VERSION_PATCH "${CMAKE_MATCH_3}")

# FILEVERSION fields are 16-bit. A larger component would not fit in the version resource.
foreach(part MAJOR MINOR PATCH)
    if(SILICONSUN_VERSION_${part} GREATER 65535)
        message(FATAL_ERROR
            "siliconsun version component ${part} is ${SILICONSUN_VERSION_${part}}; "
            "a version resource allows at most 65535.")
    endif()
endforeach()

if(SILICONSUN_OFFICIAL_BUILD)
    set(SILICONSUN_OFFICIAL_VALUE 1)
else()
    set(SILICONSUN_OFFICIAL_VALUE 0)
endif()

set(VERSION_CONTENT
"/*******************************************************************************
 *                                O P E N  T S
 *******************************************************************************
 * SPDX-License-Identifier: GPL-3.0-or-later
 * Copyright 2026 OpenTS contributors
 *
 * See LICENSE.md for applicable additional terms and warranty disclaimers.
 ******************************************************************************/

/* Generated by cmake/SiliconSunVersion.cmake. Edits are overwritten by the next build. */

#pragma once

#define SILICONSUN_VERSION_MAJOR  ${SILICONSUN_VERSION_MAJOR}
#define SILICONSUN_VERSION_MINOR  ${SILICONSUN_VERSION_MINOR}
#define SILICONSUN_VERSION_PATCH  ${SILICONSUN_VERSION_PATCH}

#define SILICONSUN_VERSION         \"${SILICONSUN_VERSION}\"
#define SILICONSUN_PRODUCT_VERSION \"siliconsun ${SILICONSUN_VERSION}\"

/* The numeric version fields of a VERSIONINFO resource. */
#define SILICONSUN_RC_FILEVERSION ${SILICONSUN_VERSION_MAJOR},${SILICONSUN_VERSION_MINOR},${SILICONSUN_VERSION_PATCH},0

/* 1 when the build is an official release of the declared product version. */
#define SILICONSUN_OFFICIAL_BUILD ${SILICONSUN_OFFICIAL_VALUE}
")

function(write_if_changed path content)
    set(existing "")
    if(EXISTS "${path}")
        file(READ "${path}" existing)
    endif()
    if(NOT existing STREQUAL content)
        file(WRITE "${path}" "${content}")
    endif()
endfunction()

if(NOT SILICONSUN_VERSION_HEADER)
    message(FATAL_ERROR "SILICONSUN_VERSION_HEADER is required.")
endif()

write_if_changed("${SILICONSUN_VERSION_HEADER}" "${VERSION_CONTENT}")
message(STATUS "siliconsun: product version ${SILICONSUN_VERSION}")
