<rml>
<head>
	<title>Install Tiberian Sun</title>
	<link type="text/template" href="dialog.rml"/>
	<link type="text/rcss" href="install.rcss"/>
</head>
<body template="dialog" data-model="install">
	<p id="notice" data-if="!busy">{{notice}}</p>
	<div id="choices" data-if="!busy">
		<div class="option">
			<span class="name">Tiberian Sun — game data and music</span>
			<span class="size">{{basesize}}</span>
		</div>
		<label class="check option">
			<input type="checkbox" data-attrif-checked="tsmovies" data-event-click="queue('tsmovies', tsmovies ? 0 : 1)"/>
			<span class="name">Tiberian Sun — campaign cinematics</span>
			<span class="size">{{tsmoviesize}}</span>
		</label>
		<label class="check option">
			<input type="checkbox" data-attrif-checked="firestorm" data-event-click="queue('firestorm', firestorm ? 0 : 1)"/>
			<span class="name">Firestorm — game data and music</span>
			<span class="size">{{firestormsize}}</span>
		</label>
		<label class="check option">
			<input type="checkbox" data-attrif-checked="fsmovies" data-event-click="queue('fsmovies', fsmovies ? 0 : 1)"/>
			<span class="name">Firestorm — campaign cinematics</span>
			<span class="size">{{fsmoviesize}}</span>
		</label>
		<div class="option total">
			<span class="name">Download size</span>
			<span class="size">{{totalsize}}</span>
		</div>
	</div>
	<p id="status" data-if="busy">{{status}}</p>
	<progress id="bar" data-if="busy" max="100" direction="right" data-attr-value="percent"/>
	<p id="error" data-if="haserror">{{error}}</p>
	<div id="actions" data-if="!busy">
		<button id="download" data-event-click="queue('download')">Download</button>
		<button id="folder" data-event-click="queue('folder')">Folder</button>
		<button id="quit" data-event-click="queue('quit')">Quit</button>
	</div>
	<div id="cancel-row" data-if="busy">
		<button id="cancel" data-event-click="queue('cancel')">Cancel</button>
	</div>
</body>
</rml>
